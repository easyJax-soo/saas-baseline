<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.baseline</groupId>
    <artifactId>module-service</artifactId>
    <version>1.0.0</version>
  </parent>
  <groupId>com.baseline.cloud</groupId>
  <artifactId>frame-service</artifactId>
  <version>1.0.0</version>
  <dependencies>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-mybatis</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.baseline</groupId>
          <artifactId>cloud-common-feign-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.alibaba.cloud</groupId>
          <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.alibaba.cloud</groupId>
          <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework.cloud</groupId>
          <artifactId>spring-cloud-starter-openfeign</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework.cloud</groupId>
          <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>druid-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-oss</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-log</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.baseline</groupId>
          <artifactId>cloud-common-feign-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-excel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-swagger</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-biz</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-local-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-utils</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.9.2</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>single</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <finalName>frame-service</finalName>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${spring-boot.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>repackage</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includeSystemScope>true</includeSystemScope>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>make-assembly</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <descriptors>
                <descriptor>${project.basedir}/assembly.xml</descriptor>
              </descriptors>
              <appendAssemblyId>false</appendAssemblyId>
              <finalName>../../../target/service-package</finalName>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>com.baseline.cloud</groupId>
          <artifactId>auth-service</artifactId>
          <version>1.0.0</version>
          <classifier>classes</classifier>
        </dependency>
        <dependency>
          <groupId>com.baseline.cloud</groupId>
          <artifactId>system-service</artifactId>
          <version>1.0.0</version>
          <classifier>classes</classifier>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
