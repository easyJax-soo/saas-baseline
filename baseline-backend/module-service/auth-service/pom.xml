<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.baseline</groupId>
        <artifactId>module-service</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>com.baseline.cloud</groupId>
    <artifactId>auth-service</artifactId>
    <version>1.0.0</version>

    <description>
        auth认证授权中心
    </description>


    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <kaptcha.version>2.3.2</kaptcha.version>
        <binarywang.version>4.6.0</binarywang.version>
        <dingtalk.version>2.1.14</dingtalk.version>
        <dingtalk-service-sdk.version>2.0.0</dingtalk-service-sdk.version>
        <sa-token.version>1.44.0</sa-token.version>
    </properties>

    <dependencies>
        <!-- 验证码 -->
        <dependency>
            <groupId>com.github.penggle</groupId>
            <artifactId>kaptcha</artifactId>
            <version>${kaptcha.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-miniapp</artifactId>
            <version>${binarywang.version}</version>
        </dependency>

        <!--钉钉-->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>dingtalk</artifactId>
            <version>${dingtalk.version}</version>
        </dependency>
        <!--旧版本-->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>alibaba-dingtalk-service-sdk</artifactId>
            <version>${dingtalk-service-sdk.version}</version>
        </dependency>



        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-utils</artifactId>
        </dependency>

        <!-- Sa-Token OAuth2.0 模块 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-oauth2</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- Sa-Token 插件：整合SSO -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-sso</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        </dependencies>



    <profiles>
        <!-- 微服务模式 -->
        <profile>
            <id>micro</id>
            <dependencies>
                <!-- 微服务模式使用feign-api -->
                <dependency>
                    <groupId>com.baseline</groupId>
                    <artifactId>cloud-common-feign-api</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>auth-service</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeSystemScope>true</includeSystemScope>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>make-assembly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/assembly.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>../../../target/service-package</finalName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!-- 单体模式 -->
        <profile>
            <id>single</id>
            <dependencies>
                <!-- 单体模式使用local-api -->
                <dependency>
                    <groupId>com.baseline</groupId>
                    <artifactId>cloud-common-local-api</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- 生成classes jar供frame-service使用 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.2.2</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>classes</classifier>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
