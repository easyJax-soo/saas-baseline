<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.baseline</groupId>
    <artifactId>module-service</artifactId>
    <version>1.0.0</version>
  </parent>
  <groupId>com.baseline.cloud</groupId>
  <artifactId>auth-service</artifactId>
  <version>1.0.0</version>
  <description>auth认证授权中心</description>
  <properties>
    <dingtalk.version>2.1.14</dingtalk.version>
    <maven.compiler.target>17</maven.compiler.target>
    <dingtalk-service-sdk.version>2.0.0</dingtalk-service-sdk.version>
    <maven.compiler.source>17</maven.compiler.source>
    <binarywang.version>4.6.0</binarywang.version>
    <sa-token.version>1.44.0</sa-token.version>
    <kaptcha.version>2.3.2</kaptcha.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.github.penggle</groupId>
      <artifactId>kaptcha</artifactId>
      <version>${kaptcha.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.binarywang</groupId>
      <artifactId>weixin-java-miniapp</artifactId>
      <version>${binarywang.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>dingtalk</artifactId>
      <version>${dingtalk.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>alibaba-dingtalk-service-sdk</artifactId>
      <version>${dingtalk-service-sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-mybatis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>druid-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-oss</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-log</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-excel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-swagger</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-biz</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baseline</groupId>
      <artifactId>cloud-common-utils</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-oauth2</artifactId>
      <version>${sa-token.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-sso</artifactId>
      <version>${sa-token.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>micro</id>
      <build>
        <finalName>auth-service</finalName>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${spring-boot.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>repackage</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includeSystemScope>true</includeSystemScope>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>make-assembly</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <descriptors>
                <descriptor>${project.basedir}/assembly.xml</descriptor>
              </descriptors>
              <appendAssemblyId>false</appendAssemblyId>
              <finalName>../../../target/service-package</finalName>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>com.baseline</groupId>
          <artifactId>cloud-common-feign-api</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>single</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.2.2</version>
            <executions>
              <execution>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>classes</classifier>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>com.baseline</groupId>
          <artifactId>cloud-common-local-api</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
