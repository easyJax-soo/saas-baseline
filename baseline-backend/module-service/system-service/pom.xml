<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.baseline</groupId>
        <artifactId>module-service</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>com.baseline.cloud</groupId>
    <artifactId>system-service</artifactId>
    <version>1.0.0</version>

    <description>
        system系统模块
    </description>

    <dependencies>


        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baseline</groupId>
            <artifactId>cloud-common-utils</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- 微服务模式 -->
        <profile>
            <id>micro</id>
            <dependencies>
                <!-- 微服务模式使用feign-api -->
                <dependency>
                    <groupId>com.baseline</groupId>
                    <artifactId>cloud-common-feign-api</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>system-service</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>make-assembly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/assembly.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>../../../target/service-package</finalName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!-- 单体模式 -->
        <profile>
            <id>single</id>
            <dependencies>
                <!-- 单体模式使用local-api -->
                <dependency>
                    <groupId>com.baseline</groupId>
                    <artifactId>cloud-common-local-api</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- 生成classes jar供frame-service使用 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.2.2</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>classes</classifier>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


</project>
